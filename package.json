{
  "name": "btui",
  "version": "0.3.0",
  "description": "Sharp, dense React components for business software. Built on Base UI.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/btnsoft/btui.git"
  },
  "homepage": "https://btnsoft.github.io/btui/",
  "keywords": [
    "react",
    "components",
    "ui",
    "base-ui",
    "design-system",
    "data-table",
    "admin"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite --config docs/vite.config.ts",
    "build": "tsdown",
    "build:docs": "vite build --config docs/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepare": "tsdown"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0"
  },
  "devDependencies": {
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@tabler/icons-react": "^3.50.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^29.1.1",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsdown": "^0.23.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}
